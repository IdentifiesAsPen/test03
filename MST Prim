priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;

vector<bool> vis(n + 1, false);

pq.push({0, 1});
long long ans = 0;

while (!pq.empty()) {
    auto [w, u] = pq.top();
    pq.pop();

    if (vis[u]) continue;

    vis[u] = true;
    ans += w;

    for (auto [v, cost] : adj[u]) {
        if (!vis[v])
            pq.push({cost, v});
    }
}
